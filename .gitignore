# IndustrialXPL-Forge .gitignore

# === Python bytecode ===
__pycache__/
*.py[cod]
*.pyo
*.so

# === Build e distribuicao ===
*.egg
*.egg-info/
dist/
build/
.eggs/
sdist/

# === Ambientes virtuais ===
.venv/
venv/
env/

# === Legacy ixf/ package root (migrated to industrialxpl/ in W16.3) ===
ixf/

# === Testes e qualidade (artefatos) ===
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.cache
.coveragerc

# === Linters e type checking ===
.mypy_cache/
.ruff_cache/

# === Dev tooling (removido do repo) ===
tools/
.githooks/
Makefile
Makefile.native
setup.py
setup.cfg
tox.ini

# === Docker (removido do repo) ===
Dockerfile
docker-compose.yml
.dockerignore

# === Documentos internos ===
HANDOFF.md
HANDOFF-AUDIT.md
pypi-manifests/

# === Temporarios e logs ===
.tmp/
.ixf/
.log/
*.log
temp/
temps/
tmp/

# === Compiled native exploits ===
industrialxpl/modules/cve/_native/*.exe
industrialxpl/modules/cve/_native/*.bin
industrialxpl/modules/cve/_native/*.out
industrialxpl/modules/cve/_native/*.o

# === Reports / outputs ===
*.json.report
*.html.report

# === IDE e sessoes ===
.claude/
.cursor/
.vscode/
.idea/
*.swp
out/
gen/

# === Segredos e credenciais ===
.env
.env.*
*.env
!.env.example
.pypirc
.netrc
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_rsa.*
*.credentials
credentials.json
secrets.json

# === Vendor local-only ===
industrialxpl/resources/vendor/*
!industrialxpl/resources/vendor/README.md
!industrialxpl/resources/vendor/submodules__malwares__*/
!industrialxpl/resources/vendor/submodules__malwares__/**
!industrialxpl/resources/vendor/submodules__ics-tools__*/
!industrialxpl/resources/vendor/submodules__ics-tools__/**
industrialxpl/resources/vendor/submodules__malwares__lisa/data/db/*
!industrialxpl/resources/vendor/submodules__malwares__lisa/data/db/README.md
industrialxpl/resources/vendor/submodules__malwares__lisa/requirements.ixf.txt

# === OS ===
.DS_Store

# === Outros ===
Pipfile
Pipfile.lock
pip-log.txt
target/
