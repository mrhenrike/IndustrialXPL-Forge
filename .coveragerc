[run]
branch = false

[report]
omit =
    */modules/*
    */native/*
    */lab_overlays/*
    */resources/*
    */tests/*
    setup.py
    */venv*/*
    */.venv/*
    */site-packages/*
    conftest.py
    */__pycache__/*
show_missing = true
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING

[paths]
source =
    .
